<UserControl x:Class="Kytto.App.InterfaceRecoveryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="InterfaceRecoveryPanel"
             AutomationProperties.Name="Kytto could not load its interface">

  <!--
    Native and independent of the web page and of IPC (§7.14). It is what stays on
    screen when the page is gone, so nothing here may need the page, the bridge or
    a command. The web view is an HwndHost and paints over anything WPF puts behind
    it, so showing this means hiding the web view, not stacking over it.

    Transparent, so the window's backdrop material shows through exactly as it does
    behind the page; the text colours are set from the same light/dark decision the
    window makes (ApplyAppearance). The top strip is the one piece of the window
    frame the page would normally declare, so it drags the window itself.
  -->
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="DragStrip" Grid.Row="0" Background="Transparent"
            MouseLeftButtonDown="OnDragStripMouseDown" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="540" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock x:Name="Glyph" HorizontalAlignment="Center" Margin="0,0,0,12"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Text="&#xE7BA;"
                   Opacity="0.65" />

        <TextBlock x:Name="Title" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="20" FontWeight="SemiBold" Text="Kytto could not load its interface" />

        <TextBlock x:Name="Message" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Opacity="0.75"
                   Text="Reload the interface. If the problem continues, quit and reopen Kytto or report a bug." />

        <TextBlock x:Name="Status" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />

        <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
          <Button x:Name="ReloadButton" Content="Reload interface" Padding="16,6" Margin="5"
                  AutomationProperties.AutomationId="ReloadInterfaceButton"
                  Click="OnReload" />
          <Button x:Name="BugReportButton" Content="Report a bug…" Padding="16,6" Margin="5"
                  ToolTip="Open the private bug report form in your browser"
                  AutomationProperties.AutomationId="ReportBugButton"
                  Click="OnReportBug" />
          <Button x:Name="GitHubButton" Content="Report on GitHub…" Padding="16,6" Margin="5"
                  ToolTip="Open a public GitHub issue in your browser"
                  AutomationProperties.AutomationId="ReportGitHubButton"
                  Click="OnReportGitHub" />
        </WrapPanel>

        <TextBlock x:Name="Note" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontSize="12" Opacity="0.65"
                   Text="Reports open in your browser. No logs or configuration are attached automatically." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
